{{/*
NOTE: this duplicates rss.xml quite a bit. but it's much neater.
NOTE: we're assembling the variables, creating a dict and running jsonify once
so that trailing commas the nastiness of JSON is handled.
*/}}
{{- $html := .Content -}}
{{- $html = partial "strip-heading-anchor.html" (dict "content" $html) -}}
{{- $html = partial "absolute-links.html" (dict "context" . "content" $html) -}}

{{- $imageURL := "" -}}
{{- with .Params.images -}}
  {{- range first 1 . -}}
    {{- with resources.Get . -}}
      {{- $imageURL = .Permalink -}}
    {{- else -}}
      {{- $imageURL = . | absURL -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{/* extract SCSS theme colors into json */}}
{{- $theme := "" -}}
{{- if (isset .Params "theme") }}
    {{ $theme = printf "scss/theme_%s.scss" $.Params.theme }}
{{ else -}}
    {{ $theme = printf "scss/theme_%s.scss" $.Site.Params.theme.default }}
{{ end -}}

{{/* dump vars into a commented out JSON expression */}}
{{ $extractor := printf `
@use "%s";
@use "scss/theme.scss" as theme;
/*! {
    "theme": "#{theme.$theme}",
    "background": "#{theme.$background}",
    "backgroundSecondary": "#{theme.$background-secondary}",
    "text": "#{theme.$text}",
    "textEmphasis": "#{theme.$text-emphasis}",
    "textSecondary": "#{theme.$text-secondary}"
} */
` $theme }}

{{/* NOTE: resources.FromString transforms the string into a resource, which can be transpiled. */}}
{{ $raw := $extractor | resources.FromString "extract.scss" | toCSS (dict "transpiler" "dartsass" "outputStyle" "expanded") }}
{{/* TODO: dislike. But to translate from SCSS vars to JSON, regex will be somewhere. */}}
{{ $jsonString := index (findRE `\{[^}]+\}` $raw.Content) 0 }}
{{ $themeColors := $jsonString | transform.Unmarshal }}

{{- dict
  "title" .Title
  "url" .Permalink
  "relativeUrl" .RelPermalink
  "slug" .Slug
  "html" $html
  "plaintext" .RawContent
  "subtitle" .Params.Summary
  "image" $imageURL
  "colors" $themeColors
| jsonify (dict "indent" "  ") -}}
