{{/*
NOTE: this duplicates rss.xml quite a bit. but it's much neater.
NOTE: we're assembling the variables, creating a dict and running jsonify once
so that trailing commas the nastiness of JSON is handled.
*/}}
{{- $html := .Content -}}
{{- $html = partial "strip-heading-anchor.html" (dict "content" $html) -}}
{{- $html = partial "absolute-links.html" (dict "context" . "content" $html) -}}

{{- $desc := "" -}}
{{- if .Params.Description -}}
  {{- $desc = .Params.Description -}}
{{- else if .Params.Summary -}}
  {{- $desc = .Params.Summary -}}
{{- else -}}
  {{- $desc = .Summary | plainify -}}
{{- end -}}

{{- $imageURL := "" -}}
{{- with .Params.images -}}
  {{- range first 1 . -}}
    {{- with resources.Get . -}}
      {{- $imageURL = .Permalink -}}
    {{- else -}}
      {{- $imageURL = . | absURL -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $theme := "" -}}
{{- if (isset .Params "theme") }}
    {{ $theme = printf "scss/theme_%s.scss" $.Params.theme }}
{{ else -}}
    {{ $theme = printf "scss/theme_%s.scss" $.Site.Params.theme.default }}
{{ end -}}

{{ $opts := dict "transpiler" "dartsass"}}
{{ $css := resources.Get $theme | resources.ExecuteAsTemplate "css/style.css" . | toCSS $opts }}

{{- dict
  "title" .Title
  "url" .Permalink
  "relativeUrl" .RelPermalink
  "slug" .Slug
  "html" $html
  "plaintext" .RawContent
  "description" $desc
  "image" $imageURL
  "css" $css.Content
| jsonify (dict "indent" "  ") -}}
